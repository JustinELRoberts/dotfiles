# Theming
theme = dark:Kanagawa Dragon,light:Kanagawa Wave
font-family = "DroidSansM Nerd Font'
font-size = 16
cursor-style-blink = false
shell-integration-features = no-cursor

# Automatically open in fullscreen mode
fullscreen = true

# Keybinds
# Tab navigation
keybind = shift+ctrl+h=previous_tab
keybind = shift+ctrl+l=next_tab

# Tab ordering
keybind = shift+ctrl+i=move_tab:-1
keybind = shift+ctrl+o=move_tab:1
